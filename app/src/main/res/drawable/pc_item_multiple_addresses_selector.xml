<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 - 粉色渐变叠加效果 -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- 第三层背景 (最底层) - 正上方偏移 - 深粉色 -->
            <item android:bottom="20dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#E7E7E7"
                        android:centerColor="#C0F2F2F2"
                        android:endColor="#80F8F8F8"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            
            <!-- 第二层背景 (中间层) - 正上方偏移 - 中粉色 -->
            <item android:bottom="10dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#F0F0F0"
                        android:centerColor="#A0F4F4F4"
                        android:endColor="#80F2F2F2"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            
            <!-- 第一层背景 (最上层) - 主背景 - 浅粉色 -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#F8F8F8"
                        android:centerColor="#E6FAFAFA"
                        android:endColor="#80F4F4F4"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#3CA4E0" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 焦点状态 - 粉色渐变增强效果 -->
    <item android:state_focused="true">
        <layer-list>
            <!-- 第三层背景 (最底层) - 正上方偏移 - 深粉色 -->
            <item android:bottom="20dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#E7E7E7"
                        android:centerColor="#B0EFEFEF"
                        android:endColor="#80F8F8F8"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            
            <!-- 第二层背景 (中间层) - 正上方偏移 - 中粉色 -->
            <item android:bottom="10dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#F0F0F0"
                        android:centerColor="#90F6F6F6"
                        android:endColor="#80F6F6F6"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            
            <!-- 第一层背景 (最上层) - 主背景 - 浅粉色 -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#F8F8F8"
                        android:centerColor="#E6FAFAFA"
                        android:endColor="#80F8F8F8"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#3CA4E0" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 选中状态 - 粉色渐变增强效果 -->
    <item android:state_selected="true">
        <layer-list>
            <!-- 第三层背景 (最底层) - 正上方偏移 - 深粉色 -->
            <item android:bottom="20dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#EBEBEB"
                        android:centerColor="#B0F0F0F0"
                        android:endColor="#80F8F8F8"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            
            <!-- 第二层背景 (中间层) - 正上方偏移 - 中粉色 -->
            <item android:bottom="10dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#F0F0F0"
                        android:centerColor="#90F4F4F4"
                        android:endColor="#80F8F8F8"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            
            <!-- 第一层背景 (最上层) - 主背景 - 浅粉色 -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#F8F8F8"
                        android:centerColor="#E6FDFDFD"
                        android:endColor="#80F4F4F4"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#3CA4E0" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 默认状态 - 粉色渐变叠加效果 -->
    <item>
        <layer-list>
            <!-- 第三层背景 (最底层) - 正上方偏移 - 深粉色 -->
            <item android:bottom="20dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#E9E9E9"
                        android:centerColor="#80EFEFEF"
                        android:endColor="#40F8F8F8"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            
            <!-- 第二层背景 (中间层) - 正上方偏移 - 中粉色 -->
            <item android:bottom="10dp" android:left="0dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#EDEDED"
                        android:centerColor="#60F6F6F6"
                        android:endColor="#40F8F8F8"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            
            <!-- 第一层背景 (最上层) - 主背景 - 浅粉色 -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#F8F8F8"
                        android:centerColor="#99FBFBFB"
                        android:endColor="#40F4F4F4"
                        android:angle="-45" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
